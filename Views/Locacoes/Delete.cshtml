@model LocaControl.Models.Locacao

@{
    ViewData["Title"] = "Excluir Locação";
}

<h1>Excluir Locação</h1>

<h3>Tem certeza que deseja excluir esta locação?</h3>
<div>
    <h4>Dados da Locação</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            Cliente
        </dt>
        <dd class="col-sm-10">
            @Model.Cliente?.Nome
        </dd>

    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            Equipamento
        </dt>
        <dd class="col-sm-10">
            @Model.Equipamento?.Nome
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            Data Inicial
        </dt>
        <dd class="col-sm-10">
            @Model.DataInicio.ToString("dd/MM/yyyy HH:mm")
        </dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">
            Data Final
        </dt>
        <dd class="col-sm-10">
            @Model.DataFinal.ToString("dd/MM/yyyy HH:mm")
        </dd>
    </dl>

    <dl class="row">
        <dt class="col-sm-2">
            ValorTotal
        </dt>
        <dd class="col-sm-10">
            @Model.ValorTotal.ToString("C")
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Excluir" class="btn btn-danger" /> |
        <a asp-action="Index">Voltar para a Lista</a>
    </form>
</div>
