@model IEnumerable<LocaControl.Models.Locacao>

@{
    ViewData["Title"] = "Locações";
}

<h1>Locações</h1>

<p>
    <a asp-action="Create">Nova Locação</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Cliente</th>
            <th>Equipamento</th>
            <th>Data Inicial</th>
            <th>Data Final</th>
            <th>Valor Total</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Cliente?.Nome
                </td>
                <td>
                    @item.Equipamento?.Nome
                </td>
                <td>
                    @item.DataInicio.ToString("dd/MM/yyyy HH:mm")
                </td>
                <td>
                    @item.DataFinal.ToString("dd/MM/yyyy HH:mm")
                    <td>
                        @item.ValorTotal.ToString("C")
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
